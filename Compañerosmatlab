%% Carga de Datos
base_path = 'C:\Users\pepit\Documents\7mo\IA\MNIST\dataset_numeros\';
data_train = readmatrix(fullfile(base_path, 'emnist-mnist-train.csv'));
data_test = readmatrix(fullfile(base_path, 'emnist-mnist-test.csv'));

%% Preparación de Datos
Y_train = categorical(data_train(:, 1));
Y_test = categorical(data_test(:, 1));

X_train_plano = data_train(:, 2:end) / 255;
X_test_plano = data_test(:, 2:end) / 255;

X_train = reshape(X_train_plano', 28, 28, 1, []);
X_test = reshape(X_test_plano', 28, 28, 1, []);

%% Definición de la Arquitectura
layers = [
    imageInputLayer([28 28 1])
    
    fullyConnectedLayer(128)
    reluLayer
    
    fullyConnectedLayer(64)
    reluLayer
    
    fullyConnectedLayer(15)
    reluLayer
    
    fullyConnectedLayer(10)
    softmaxLayer
    classificationLayer
];

%% Opciones y Entrenamiento
options = trainingOptions('adam', ...
    'MaxEpochs', 30, ...
    'MiniBatchSize', 128, ...
    'InitialLearnRate', 0.001, ...
    'Verbose', true);

net = trainNetwork(X_train, Y_train, layers, options);

%% Evaluación y Métricas
Y_pred_train = classify(net, X_train);
Y_pred_test = classify(net, X_test);

acc_train = sum(Y_pred_train == Y_train) / numel(Y_train);
acc_test = sum(Y_pred_test == Y_test) / numel(Y_test);

error_train = 1 - acc_train;
error_test = 1 - acc_test;

fprintf('\n--- RESULTADOS GLOBALES ---\n');
fprintf('Precisión (Accuracy) Entrenamiento: %.2f%%\n', acc_train * 100);
fprintf('Error de Clasificación Entrenamiento: %.2f%%\n', error_train * 100);
fprintf('----------------------------------\n');
fprintf('Precisión (Accuracy) Testeo: %.2f%%\n', acc_test * 100);
fprintf('Error de Clasificación Testeo: %.2f%%\n', error_test * 100);

figure('Name', 'Matriz de Confusión');
cm = confusionchart(Y_test, Y_pred_test);
cm.ColumnSummary = 'column-normalized';
cm.RowSummary = 'row-normalized';
